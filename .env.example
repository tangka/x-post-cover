# DeepSeek API key for translation — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Absolute path to the folder where each post's assets will be saved
LIBRARY=/path/to/your/library

# Target translation language (BCP 47 tag: zh, ja, ko, fr, de, es ...)
TARGET_LANG=zh

# QR code visibility: show | hide
QRCODE=show

# ── Optional overrides (defaults work on macOS with Chrome) ──────────────────

# Path to the Chrome executable
# CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Path to Chrome's Cookies SQLite database (change if using a non-default profile)
# COOKIES_DB=/Users/<you>/Library/Application Support/Google/Chrome/Default/Cookies
